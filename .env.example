# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./dev.db

# Secret keys (KHÔNG lưu secret thật trong repo)
SECRET_KEY=replace-with-secure-random-string

# Mount brain (chỉ dev). Đặt "true" khi bạn muốn expose /_brain cục bộ.
BRAIN_MOUNT=false

# Optional
REDIS_URL=redis://localhost:6379/0
